rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }
    match /projects/{id} {
      allow read: if resource.data.status == 'Published' || resource.data.status == null || isAdmin();
      allow write: if isAdmin();
    }
    match /posts/{id} {
      allow read: if resource.data.status == 'Published' || isAdmin();
      allow write: if isAdmin();
    }
    match /testimonials/{id} { allow read: if resource.data.status == 'Published' || isAdmin(); allow write: if isAdmin(); }
    match /team/{id} { allow read: if resource.data.status == 'Published' || isAdmin(); allow write: if isAdmin(); }
    match /settings/{id} { allow read: if true; allow write: if isAdmin(); }
    match /messages/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name','email','phone','projectType','projectLocation','timeline','message','createdAt','read'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.email is string && request.resource.data.email.size() > 3
        && request.resource.data.message is string && request.resource.data.message.size() >= 10;
      allow read, update, delete: if isAdmin();
    }
  }
}
